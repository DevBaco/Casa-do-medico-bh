# Redirects 301 — migração Wix → Astro (ver docs/migracao/plano-migracao.md)
# As URLs acentuadas do Wix podem chegar ao servidor tanto decodificadas (UTF-8)
# quanto percent-encoded, dependendo da configuração do Apache — por isso cada
# URL acentuada tem duas regras (uma para cada forma).

RewriteEngine On

# /meias-compressivas (slug antigo do site Astro) -> /meias-de-compressão
RewriteRule ^meias-compressivas/?$ /meias-de-compressão [R=301,L,NC]

# /venosan-e-sigvaris-em-belo-horizonte -> /meias-de-compressão
RewriteRule ^venosan-e-sigvaris-em-belo-horizonte/?$ /meias-de-compressão [R=301,L,NC]

# Páginas "blank" do Wix (sem conteúdo reaproveitável)
RewriteRule ^blank-1/?$ /#nossa-historia [R=301,L,NC]
RewriteRule ^blank-2/?$ /#contato [R=301,L,NC]
RewriteRule ^blank-3/?$ / [R=301,L,NC]

# Blog (não recriado)
RewriteRule ^blog/?$ / [R=301,L,NC]

# Posts do blog -> catálogo de meias de compressão
RewriteRule ^post/como-saber-o-tamanho-ideal-da-sua-meia-de-compressão/?$ /meias-de-compressão [R=301,L,NC]
RewriteRule ^post/como-saber-o-tamanho-ideal-da-sua-meia-de-compress%C3%A3o/?$ /meias-de-compressão [R=301,L,NC]

RewriteRule ^post/meias-de-compressão-em-bh-qual-o-modelo-ideal-para-você/?$ /meias-de-compressão [R=301,L,NC]
RewriteRule ^post/meias-de-compress%C3%A3o-em-bh-qual-o-modelo-ideal-para-voc%C3%AA/?$ /meias-de-compressão [R=301,L,NC]

RewriteRule ^post/produtos-médico-hospitalares-em-belo-horizonte-conheça-a-casa-do-médico-bh/?$ /meias-de-compressão [R=301,L,NC]
RewriteRule ^post/produtos-m%C3%A9dico-hospitalares-em-belo-horizonte-conhe%C3%A7a-a-casa-do-m%C3%A9dico-bh/?$ /meias-de-compressão [R=301,L,NC]

# Página de erro 404 personalizada
ErrorDocument 404 /404.html
