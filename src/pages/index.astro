---
import {
  ArrowRight,
  Camera,
  HeartHandshake,
  Mail,
  MapPin,
  PackageCheck,
  Phone,
  Share2,
} from "lucide-react";
import BrandCarousel from "@/components/BrandCarousel";
import CompressionFinder from "@/components/CompressionFinder";
import HomeHeroCarousel from "@/components/HomeHeroCarousel";
import SiteHeader from "@/components/SiteHeader.astro";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import { getCatalogPopularFilterPath } from "@/data/catalog-filters";
import { catalogProducts } from "@/data/catalog-products";
import { compressionStockingBrands } from "@/data/compression-stockings";
import Layout from "@/layouts/Layout.astro";
import { cn } from "@/lib/utils";
import { WHATSAPP_URL } from "@/lib/whatsapp";

function toKey(value: string) {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const compressionFinderBrands = compressionStockingBrands.map((brand) => ({
  id: brand.id,
  name: brand.name,
  lines: Array.from(new Map(brand.lines.map((line) => [toKey(line.line), line.line])).entries()).map(
    ([key, label]) => ({ key, label })
  ),
}));

function categoryShortcut(productId: string, label: string, filterId: string) {
  const product = catalogProducts.find((item) => item.id === productId);

  if (!product) {
    throw new Error(`Produto não encontrado para o atalho da home: ${productId}`);
  }

  return {
    label,
    href: getCatalogPopularFilterPath(filterId),
    image: product.images[0],
  };
}

const categoryShortcuts = [
  {
    label: "Meias compressivas",
    href: "/meias-compressivas",
    image: {
      src: "/Venosan/COMFORTLINE/AD-COMFORT PERNA FEMININA.webp",
      alt: "Meia de compressão até o joelho",
    },
  },
  categoryShortcut("aparelho-de-pressao-digital", "Pressão arterial", "pressao-arterial"),
  categoryShortcut("oximetro-de-dedo", "Oxímetros", "oximetros"),
  categoryShortcut("glicometro", "Glicemia", "glicemia"),
  categoryShortcut("joelheiras", "Joelheiras", "joelheiras"),
  categoryShortcut("andador", "Andadores", "andadores"),
  categoryShortcut("cadeira-de-banho", "Cadeiras de banho", "cadeiras-de-banho"),
  categoryShortcut("curativos", "Curativos", "curativos"),
  categoryShortcut("luvas-descartaveis", "Luvas", "luvas"),
  categoryShortcut("faixa-elastica-para-exercicios", "Fisioterapia", "fisioterapia"),
];

const compressionLineCount = compressionStockingBrands.reduce(
  (total, brand) => total + new Set(brand.lines.map((line) => line.line)).size,
  0
);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "Casa do Médico BH",
  image: "https://www.casadomedicobh.com.br/images/home/logo-casa-do-medico-wordmark.webp",
  url: "https://www.casadomedicobh.com.br/",
  telephone: "+55 31 3224-4407",
  email: "bramelbrasilmedica@gmail.com",
  foundingDate: "1954-12-28",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Afonso Pena, 981",
    addressLocality: "Belo Horizonte",
    addressRegion: "MG",
    postalCode: "30130-907",
    addressCountry: "BR",
  },
  sameAs: [
    "https://www.instagram.com/casadomedico_/",
    "https://www.facebook.com/profile.php?id=100090896740956",
  ],
};
---

<Layout
  title="Casa do Médico BH · Produtos médicos, ortopédicos e meias de compressão"
  description="Casa do Médico BH é referência em meias de compressão, produtos ortopédicos e equipamentos de saúde em Belo Horizonte. Atendimento especializado desde 1954."
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <div class="border-b border-primary-foreground/15 bg-primary text-primary-foreground">
