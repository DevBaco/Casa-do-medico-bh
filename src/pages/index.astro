            <br />
            Preencha a busca ao lado!
            <ArrowRight className="ml-1.5 inline size-6 animate-bounce align-middle" />
          </p>
        </div>

        <Card className="gap-0 border-white/20 bg-background py-0 text-foreground shadow-2xl">
          <CardHeader className="border-b p-5 sm:p-6">
            <Badge variant="secondary">Busca rápida</Badge>
