        <div class="flex items-center gap-3 px-2 py-4 sm:px-4">
          <span class="grid size-11 shrink-0 place-items-center overflow-hidden rounded-xl border bg-background p-1.5 shadow-sm">
            <img src="/images/home/logo-casa-do-medico-symbol.webp" alt="" class="size-full object-contain" />
          </span>
          <span>
            <strong class="block text-sm leading-tight">Loja no Centro de BH</strong>
            <span class="mt-1 block text-xs leading-tight text-muted-foreground">Av. Afonso Pena, 981</span>
          </span>
        </div>
        <div class="flex items-center gap-3 px-3 py-4 sm:px-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/15">
