      </div>
    </section>

    <section class="border-b bg-background">
      <div class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-6 lg:py-18">
        <div class="max-w-2xl">
          <Badge variant="secondary">Marcas parceiras</Badge>
