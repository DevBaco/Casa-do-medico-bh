              >
                <Camera className="size-4" />
              </a>
              <a
                href="https://www.facebook.com/profile.php?id=100090896740956"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook da Casa do Médico BH"
                class={buttonVariants({ variant: "outline", size: "icon-sm" })}
