            <span class="mt-1 block text-xs leading-tight text-muted-foreground">Linhas disponíveis na loja</span>
          </span>
        </div>
        <div class="flex items-center gap-3 px-3 py-4 sm:px-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-primary shadow-sm">
