          </CardHeader>
          <CardContent className="p-5 sm:p-6">
            <div class="mb-5 grid grid-cols-3 gap-3">
              {compressionStockingBrands.map((brand) => (
                <div class="flex min-h-14 items-center justify-center rounded-xl border bg-white p-3 shadow-sm">
                  <img src={brand.logo} alt={brand.name} loading="lazy" class="max-h-7 max-w-full object-contain" />
                </div>
              ))}
