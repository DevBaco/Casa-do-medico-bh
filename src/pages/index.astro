        <Card className="gap-0 bg-background py-0 text-foreground shadow-2xl">
          <CardContent className="grid gap-5 p-5 sm:grid-cols-2 sm:p-7">
            <div class="flex items-start gap-3">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <MapPin className="size-5" />
              </span>
              <div>
                <h3 class="font-semibold">Endereço</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Av. Afonso Pena, 981<br />Centro · Belo Horizonte/MG<br />CEP 30130-907</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <Phone className="size-5" />
