---
import { Activity, ArrowRight, Boxes, MapPin, MessageCircle, ShieldCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import BrandCarousel from "@/components/BrandCarousel";
import CompressionFinder from "@/components/CompressionFinder";
import ProductCatalogNavigator from "@/components/ProductCatalogNavigator.astro";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { compressionStockingBrands } from "@/data/compression-stockings";
import { cn } from "@/lib/utils";
import { WHATSAPP_URL } from "@/lib/whatsapp";

function toKey(value: string) {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const compressionFinderBrands = compressionStockingBrands.map((brand) => ({
  id: brand.id,
  name: brand.name,
  lines: Array.from(new Map(brand.lines.map((line) => [toKey(line.line), line.line])).entries()).map(
    ([key, label]) => ({ key, label })
  ),
}));
---

<Layout
  title="Casa do Médico BH · Produtos médicos e meias compressivas"
  description="Encontre meias compressivas Venosan, Sigvaris e Genoven, produtos ortopédicos e equipamentos de saúde com atendimento especializado em Belo Horizonte."
>
  <header class="sticky top-0 z-30 border-b bg-background/95 backdrop-blur-md">
    <div class="mx-auto flex min-h-[72px] w-full max-w-7xl items-center justify-between gap-5 px-5 sm:px-6">
      <a href="/" aria-label="Casa do Médico BH">
        <img src="/logo/casa-do-medico.png" alt="Casa do Médico BH" class="h-12 w-auto" />
      </a>
      <div class="flex items-center gap-2">
        <a
          href="/produtos"
          class={cn(buttonVariants({ variant: "outline" }), "hidden sm:inline-flex")}
        >
          Produtos
        </a>
        <a
          href="/meias-compressivas"
          class={cn(buttonVariants({ variant: "outline" }), "hidden md:inline-flex")}
        >
          Meias compressivas
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants()}
        >
          <img src="/icons/whatsapp.svg" alt="" class="size-4" />
          Fale conosco
        </a>
      </div>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden border-b bg-secondary/60">
      <div class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="mx-auto grid min-h-[620px] w-full max-w-7xl items-center gap-12 px-5 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(360px,0.9fr)] lg:py-24">
        <div class="relative z-10 max-w-3xl">
          <Badge>Casa do Médico BH · desde 1954</Badge>
          <h1 class="mt-5 text-4xl font-bold tracking-tight sm:text-6xl">
            Encontre sua meia compressiva por marca e linha
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
            Selecione a marca e a linha desejada. Você será levado direto às meias correspondentes,
            com os dois filtros já aplicados.
          </p>

          <div class="mt-8">
            <CompressionFinder brands={compressionFinderBrands} client:idle />
          </div>

          <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted-foreground">
            <span class="inline-flex items-center gap-2">
              <ShieldCheck className="size-4 text-primary" />
              Atendimento especializado
            </span>
            <span class="inline-flex items-center gap-2">
              <MapPin className="size-4 text-primary" />
              Belo Horizonte
            </span>
            <span class="inline-flex items-center gap-2">
              <MessageCircle className="size-4 text-primary" />
              Disponibilidade pelo WhatsApp
            </span>
          </div>
        </div>

        <div class="relative mx-auto hidden w-full max-w-lg lg:block" aria-hidden="true">
          <div class="absolute inset-8 rounded-full bg-primary/10 blur-3xl"></div>
          <div class="relative grid grid-cols-2 gap-4">
            <Card className="translate-y-10 overflow-hidden py-0">
              <div class="flex h-80 items-stretch justify-center overflow-hidden bg-white">
                <img
                  src="/Venosan/COMFORTLINE/AD-COMFORT PERNA FEMININA.webp"
                  alt=""
                  class="h-full w-full object-contain object-center"
                />
              </div>
              <CardContent className="border-t p-4">
                <img
                  src="/Marcas/logo-venosan-meias-compressivas.svg"
                  alt=""
                  class="h-7 max-w-32 object-contain"
                />
              </CardContent>
            </Card>
            <Card className="overflow-hidden py-0">
              <div class="flex h-80 items-stretch justify-center overflow-hidden bg-white">
                <img
                  src="/Sigvaris/Performance (esportiva)/ACM_HighTech_CW_black.jpg"
                  alt=""
                  class="h-full w-full object-contain object-center"
                />
              </div>
              <CardContent className="border-t p-4">
                <img
                  src="/Marcas/sig9000_sigvaris_group_160th_logo_dual_horizontal_darkblue_rgb.svg"
                  alt=""
                  class="h-7 max-w-36 object-contain"
                />
              </CardContent>
            </Card>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b bg-secondary/40">
      <div class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-6 lg:py-20">
        <div class="max-w-3xl">
          <Badge>Catálogo de produtos · sem preços fixos</Badge>
          <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
            Catálogo de produtos médicos e ortopédicos
          </h2>
          <p class="mt-2 leading-relaxed text-muted-foreground">
            Escolha um produto para abrir diretamente o item e encontrar opções semelhantes no
            catálogo completo.
          </p>
        </div>

        <div class="mt-8">
          <ProductCatalogNavigator basePath="/produtos" />
        </div>
      </div>
    </section>

    <section class="border-b bg-background">
      <div class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-6 lg:py-20">
        <div class="max-w-3xl">
          <Badge variant="secondary">Explore sem aplicar filtros</Badge>
          <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
            Acesse o catálogo completo
          </h2>
          <p class="mt-2 leading-relaxed text-muted-foreground">
            Se preferir navegar por todas as opções, escolha um dos catálogos abaixo.
          </p>
        </div>

        <div class="mt-8 grid gap-5 lg:grid-cols-2">
          <Card className="overflow-hidden border-primary/20">
            <CardContent className="flex h-full flex-col gap-5 sm:flex-row sm:items-center">
              <span class="grid size-14 shrink-0 place-items-center rounded-lg bg-primary text-primary-foreground">
                <Activity className="size-7" />
              </span>
              <div class="flex-1">
                <Badge>Catálogo exclusivo</Badge>
                <h3 class="mt-3 text-xl font-bold">Meias compressivas</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                  Veja todas as linhas Venosan, Sigvaris e Genoven sem filtros aplicados.
                </p>
                <a
                  href="/meias-compressivas"
                  class={cn(buttonVariants({ size: "lg" }), "mt-5 w-full sm:w-auto")}
                >
                  Ver todas as meias
                  <ArrowRight className="size-4" />
                </a>
              </div>
            </CardContent>
          </Card>

          <Card className="overflow-hidden border-accent/40">
            <CardContent className="flex h-full flex-col gap-5 sm:flex-row sm:items-center">
              <span class="grid size-14 shrink-0 place-items-center rounded-lg bg-accent text-accent-foreground">
                <Boxes className="size-7" />
              </span>
              <div class="flex-1">
                <Badge variant="secondary">Catálogo de produtos</Badge>
                <h3 class="mt-3 text-xl font-bold">Outros produtos médicos</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                  Explore monitoramento, ortopedia, mobilidade, cuidados em casa e fisioterapia.
                </p>
                <a
                  href="/produtos"
                  class={cn(
                    buttonVariants({ variant: "outline", size: "lg" }),
                    "mt-5 w-full sm:w-auto"
                  )}
                >
                  Ver todos os produtos
                  <ArrowRight className="size-4" />
                </a>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>

    <section class="overflow-hidden border-b bg-secondary/40">
      <div class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-10 lg:py-20">
        <div class="max-w-3xl">
          <Badge variant="secondary">Marcas</Badge>
          <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
            Encontre produtos pela marca
          </h2>
          <p class="mt-2 leading-relaxed text-muted-foreground">
            As marcas de meias abrem o catálogo com a marca selecionada. As demais levam ao catálogo
            geral, onde você pode pesquisar o produto desejado.
          </p>
        </div>

        <div class="mt-8">
          <BrandCarousel client:visible />
        </div>
      </div>
    </section>

  </main>

  <footer class="border-t bg-secondary">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p class="text-sm text-muted-foreground">
        Casa do Médico BH — produtos médicos e atendimento consultivo desde 1954.
      </p>
      <img src="/logo/casa-do-medico-pb.png" alt="" class="h-10 w-auto opacity-60" />
    </div>
  </footer>
</Layout>
