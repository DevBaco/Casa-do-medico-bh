---
import {
  ArrowDown,
  ArrowRight,
  HeartHandshake,
  PackageCheck,
  Star,
} from "lucide-react";
import BrandCarousel from "@/components/BrandCarousel";
import GoogleReviewCta from "@/components/GoogleReviewCta.astro";
import CompressionFinder from "@/components/CompressionFinder";
import GoogleReviewsCarousel from "@/components/GoogleReviewsCarousel";
import HomeHeroCarousel from "@/components/HomeHeroCarousel";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import {
  catalogSubcategories,
  getCatalogCategoryFilterPath,
  getCatalogPopularFilterPath,
} from "@/data/catalog-filters";
import { catalogProducts } from "@/data/catalog-products";
import { compressionStockingBrands } from "@/data/compression-stockings";
import Layout from "@/layouts/Layout.astro";
import { OPENING_HOURS_SCHEMA } from "@/lib/business";
import { GOOGLE_REVIEW_URL } from "@/lib/google";
import { cn } from "@/lib/utils";
import { WHATSAPP_URL } from "@/lib/whatsapp";

function toKey(value: string) {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const compressionFinderBrands = compressionStockingBrands.map((brand) => ({
  id: brand.id,
  name: brand.name,
  lines: Array.from(new Map(brand.lines.map((line) => [toKey(line.line), line.line])).entries()).map(
    ([key, label]) => ({ key, label })
  ),
}));

function categoryShortcut(subcategoryId: string, labelOverride?: string) {
  const subcategory = catalogSubcategories.find((item) => item.id === subcategoryId);
  const product = catalogProducts.find((item) => item.id === subcategory?.featuredProductId);

  if (!subcategory || !product) {
    throw new Error(`Grupo ou produto de destaque não encontrado: ${subcategoryId}`);
  }

  return {
    label: labelOverride ?? subcategory.label,
    href: getCatalogPopularFilterPath(subcategory.id),
    image: product.images[0],
  };
}

function broadCategoryShortcut(
  productId: string,
  label: string,
  categoryId: "monitoramento" | "ortopedia-mobilidade" | "cuidados-medico-hospitalares" | "fisioterapia-recuperacao"
) {
  const product = catalogProducts.find((item) => item.id === productId);

  if (!product) {
    throw new Error(`Produto de destaque não encontrado: ${productId}`);
  }

  return {
    label,
    href: getCatalogCategoryFilterPath(categoryId),
    image: product.images[0],
  };
}

const categoryShortcuts = [
  {
    label: "Meias compressivas",
    href: "/meias-de-compressão",
    image: {
      src: "/Venosan/COMFORTLINE/AD-COMFORT PERNA FEMININA.webp",
      alt: "Meia de compressão até o joelho",
    },
  },
  categoryShortcut("pressao-e-saturacao"),
  categoryShortcut("glicemia"),
  broadCategoryShortcut("joelheira-ajustavel-hastes-aco", "Ortopedia e mobilidade", "ortopedia-mobilidade"),
  categoryShortcut("descartaveis-e-protecao"),
  categoryShortcut("curativos-e-coberturas"),
  categoryShortcut("capas-e-protetores-de-colchao"),
  categoryShortcut("injecao-e-acesso", "Seringas, agulhas e cateteres"),
  broadCategoryShortcut("fita-kinesio-5cm-5m", "Fisioterapia", "fisioterapia-recuperacao"),
];

const compressionLineCount = compressionStockingBrands.reduce(
  (total, brand) => total + new Set(brand.lines.map((line) => line.line)).size,
  0
);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "Casa do Médico BH",
  image: "https://casadomedicobh.com.br/images/home/logo-casa-do-medico-wordmark.webp",
  url: "https://casadomedicobh.com.br/",
  telephone: "+55 31 3224-4407",
  email: "bramelbrasilmedica@gmail.com",
  foundingDate: "1954-12-28",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Afonso Pena, 981",
    addressLocality: "Belo Horizonte",
    addressRegion: "MG",
    postalCode: "30130-907",
    addressCountry: "BR",
  },
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  sameAs: [
    "https://www.instagram.com/casadomedico_/",
    "https://www.facebook.com/profile.php?id=100090896740956",
  ],
};
---

<Layout
  title="Casa do Médico BH | Loja de Insumos Médicos em BH - Meias de Compressão e Produtos Hospitalares"
  description="Casa do Médico BH é referência em meias de compressão, oxímetros e aparelhos de pressão em Belo Horizonte. Desde 1954 com atendimento especializado e os melhores produtos hospitalares e ortopédicos."
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <SiteHeader />

  <main>
    <section id="categorias" class="scroll-mt-32 border-b bg-background">
      <div class="mx-auto w-full max-w-7xl px-5 py-6 sm:px-6 sm:py-8">
        <div>
          <p class="text-xs font-semibold tracking-wide text-primary uppercase">Explore o catálogo</p>
          <h2 class="mt-1 text-lg font-bold tracking-tight sm:text-xl">Categorias em destaque</h2>
        </div>

        <div class="mt-5 flex snap-x gap-4 overflow-x-auto pb-1 [scrollbar-width:none] lg:grid lg:grid-cols-9 lg:overflow-visible [&::-webkit-scrollbar]:hidden">
          {categoryShortcuts.map((category) => (
            <a href={category.href} class="group block w-24 shrink-0 snap-start sm:w-28 lg:w-auto">
              <Card className="h-full gap-0 border-0 bg-transparent py-0 shadow-none">
                <div class="mx-auto flex size-20 items-center justify-center overflow-hidden rounded-full bg-background p-3 shadow-sm ring-1 ring-border transition-[transform,box-shadow] duration-200 group-hover:-translate-y-1 group-hover:shadow-md sm:size-24">
                  <img
                    src={category.image.src}
                    alt={category.image.alt}
                    loading="lazy"
                    class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-110"
                  />
                </div>
                <CardContent className="flex min-h-12 items-start justify-center px-1 pt-2.5 pb-0 text-center">
                  <h3 class="text-xs leading-tight font-medium group-hover:text-primary sm:text-sm">{category.label}</h3>
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b bg-background">
      <div class="mx-auto w-full max-w-7xl px-4 py-5 sm:px-6 sm:py-6">
        <HomeHeroCarousel client:visible />
      </div>
    </section>

    <section class="border-b bg-background" aria-label="Diferenciais da loja">
