---
import {
  Activity,
  Dumbbell,
  HeartPulse,
  House,
  Search,
} from "lucide-react";
import CatalogProductCard from "@/components/CatalogProductCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import {
  catalogCategories,
  catalogProducts,
  type CatalogCategoryId,
} from "@/data/catalog-products";
import { storeBrands } from "@/data/brands";
import Layout from "@/layouts/Layout.astro";
import { cn } from "@/lib/utils";
import { WHATSAPP_URL } from "@/lib/whatsapp";

const categoryIcons = {
  monitoramento: Activity,
  "ortopedia-mobilidade": HeartPulse,
  "cuidados-medico-hospitalares": House,
  "fisioterapia-recuperacao": Dumbbell,
} satisfies Record<CatalogCategoryId, typeof Activity>;

const categorySections = catalogCategories.map((category) => ({
  ...category,
  Icon: categoryIcons[category.id],
  products: catalogProducts.filter((product) => product.categoryId === category.id),
}));

const brandNameById = new Map(storeBrands.map((brand) => [brand.id, brand.name]));

const getProductSearchText = (product: (typeof catalogProducts)[number]) =>
  [
    product.name,
    product.brandIds.map((brandId) => brandNameById.get(brandId) ?? "").join(" "),
    product.summary,
    product.description,
    product.badges.join(" "),
    product.keywords.join(" "),
  ].join(" ");
---

<Layout
  title="Produtos Médicos e Ortopédicos em BH · Casa do Médico BH"
  description="Catálogo de produtos médicos, ortopédicos, mobilidade, monitoramento e cuidados em casa em Belo Horizonte. Consulte marcas, modelos e disponibilidade pelo WhatsApp."
>
  <header class="sticky top-0 z-30 border-b bg-background/95 backdrop-blur-md">
    <div class="mx-auto flex min-h-[72px] w-full max-w-7xl items-center justify-between gap-5 px-5 sm:px-6">
      <a href="/" aria-label="Casa do Médico BH">
        <img src="/logo/casa-do-medico.png" alt="Casa do Médico BH" class="h-12 w-auto" />
      </a>
      <div class="flex items-center gap-2">
        <a href="/" class={cn(buttonVariants({ variant: "ghost" }), "hidden lg:inline-flex")}>
          Início
        </a>
        <a
          href="/meias-compressivas"
          class={cn(buttonVariants({ variant: "outline" }), "hidden sm:inline-flex")}
        >
          Catálogo de meias
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants()}
        >
          <img src="/icons/whatsapp.svg" alt="" class="size-4" />
          Fale conosco
        </a>
      </div>
    </div>
  </header>

  <main>
    <h1 class="sr-only">Catálogo de produtos médicos e ortopédicos</h1>

    <section class="border-b bg-background">
      <div class="mx-auto w-full max-w-7xl px-5 py-6 sm:px-6 lg:py-8">
        <Card className="gap-0 overflow-hidden py-0 shadow-sm">
          <CardContent className="p-0">
            <div class="px-5 py-5 sm:px-6">
              <h2 class="text-xl font-semibold sm:text-2xl">Todos os produtos</h2>
              <p class="mt-1 text-sm text-muted-foreground">Organizados por categoria</p>
            </div>

            <div class="border-t px-5 py-4 sm:px-6">
              <label for="catalog-product-search" class="mb-2 block text-sm font-semibold">
                Pesquisar no catálogo
              </label>
              <div class="relative max-w-2xl">
                <Search className="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-muted-foreground" />
                <Input
                  id="catalog-product-search"
                  type="search"
                  placeholder="Pesquise por produto ou marca..."
                  autocomplete="off"
                  className="h-11 bg-background pr-4 pl-11 text-base"
                />
              </div>
              <p id="catalog-search-status" class="sr-only" aria-live="polite"></p>
            </div>
          </CardContent>
        </Card>
      </div>
    </section>

    {categorySections.map(({ Icon, products, ...category }, index) => (
      <section
        id={category.id}
        data-product-section
        class:list={[
          "scroll-mt-20 border-b",
          index % 2 === 0 ? "bg-secondary/40" : "bg-background",
        ]}
      >
        <div class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-6 lg:py-16">
          <div class="mb-8 flex max-w-4xl items-start gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-lg bg-primary text-primary-foreground shadow-sm">
              <Icon className="size-6" />
            </span>
            <div>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{category.name}</h2>
              <p class="mt-2 leading-relaxed text-muted-foreground">{category.description}</p>
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {products.map((product) => (
              <div data-product-card data-search={getProductSearchText(product)}>
                <CatalogProductCard product={product} />
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section data-catalog-empty class="hidden border-b bg-background">
      <div class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-6">
        <Card className="border-dashed">
          <CardContent className="text-center">
            <Search className="mx-auto size-8 text-muted-foreground" />
            <h2 class="mt-4 text-xl font-semibold">Nenhum produto encontrado</h2>
            <p class="mt-2 text-sm text-muted-foreground">
              Tente pesquisar por outro produto, categoria ou marca.
            </p>
          </CardContent>
        </Card>
      </div>
    </section>

  </main>

  <footer class="border-t bg-secondary">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p class="text-sm text-muted-foreground">
        Casa do Médico BH — produtos médicos e atendimento consultivo desde 1954.
      </p>
      <img src="/logo/casa-do-medico-pb.png" alt="" class="h-10 w-auto opacity-60" />
    </div>
  </footer>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("#catalog-product-search");
  const searchStatus = document.querySelector<HTMLElement>("#catalog-search-status");
  const productCards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-product-card]")
  );
  const productSections = Array.from(
    document.querySelectorAll<HTMLElement>("[data-product-section]")
  );
  const emptyState = document.querySelector<HTMLElement>("[data-catalog-empty]");

  const normalizeSearch = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase("pt-BR")
      .trim();

  const searchableProducts = productCards.map((element) => ({
    element,
    search: normalizeSearch(element.dataset.search ?? ""),
  }));

  searchInput?.addEventListener("input", () => {
    const query = normalizeSearch(searchInput.value);
    let visibleProducts = 0;

    searchableProducts.forEach(({ element, search }) => {
      const isVisible = !query || search.includes(query);
      element.classList.toggle("hidden", !isVisible);
      if (isVisible) visibleProducts += 1;
    });

    productSections.forEach((section) => {
      const hasVisibleProduct = section.querySelector("[data-product-card]:not(.hidden)");
      section.classList.toggle("hidden", !hasVisibleProduct);
    });

    emptyState?.classList.toggle("hidden", visibleProducts !== 0);

    if (searchStatus) {
      searchStatus.textContent = visibleProducts === 0
        ? "Nenhum produto encontrado"
        : "Resultados da pesquisa atualizados";
    }
  });

</script>
