---
import Layout from "@/layouts/Layout.astro";
import CompressionLineCatalog from "@/components/CompressionLineCatalog";
import { Badge } from "@/components/ui/badge";
import { compressionStockingBrands, compressionStockingLines } from "@/data/compression-stockings";
---

<Layout
  title="Meias Compressivas em BH · Casa do Médico BH"
  description="Catálogo de meias compressivas Venosan, Sigvaris e Genoven em Belo Horizonte. Consulte disponibilidade por marca, linha, cor, compressão e tamanho pelo WhatsApp."
>
  <header class="sticky top-0 z-20 border-b bg-background/95 backdrop-blur-md">
    <div class="mx-auto flex min-h-[72px] w-full max-w-7xl items-center justify-between gap-6 px-5 sm:px-6">
      <a href="/" class="flex items-center gap-3" aria-label="Casa do Médico BH">
        <img src="/logo/casa-do-medico.png" alt="Casa do Médico BH" class="h-12 w-auto" />
      </a>
      <nav class="hidden items-center gap-5 text-sm font-medium text-muted-foreground md:flex">
        <a href="#venosan" class="transition-colors hover:text-foreground">Venosan</a>
        <a href="#sigvaris" class="transition-colors hover:text-foreground">Sigvaris</a>
        <a href="#genoven" class="transition-colors hover:text-foreground">Genoven</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="border-b bg-secondary/60">
      <div class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:py-14">
        <div class="max-w-3xl">
          <Badge>Catálogo · Meias compressivas</Badge>
          <h1 class="mt-4 text-3xl font-bold tracking-tight text-foreground sm:text-5xl">
            Meias compressivas em BH por marca, linha e disponibilidade
          </h1>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
            Consulte linhas Venosan, Sigvaris e Genoven sem preços fixos no site.
            Cada produto possui uma página com cores, descrição, compressões e tabela de medidas.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <Badge variant="secondary">Sem preços no site</Badge>
            <Badge variant="secondary">Consulta por WhatsApp</Badge>
            <Badge variant="secondary">Página por produto</Badge>
            <Badge variant="secondary">Dados prontos para busca e filtros</Badge>
          </div>
        </div>

        <div class="rounded-xl border bg-background p-5">
          <p class="text-sm font-semibold text-foreground">Estrutura do catálogo</p>
          <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
            <div>
              <dt class="text-muted-foreground">Marcas</dt>
              <dd class="mt-1 text-2xl font-semibold">{compressionStockingBrands.length}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Produtos</dt>
              <dd class="mt-1 text-2xl font-semibold">{compressionStockingLines.length}</dd>
            </div>
            <div class="col-span-2">
              <dt class="text-muted-foreground">Próximos filtros previstos</dt>
              <dd class="mt-1 font-medium">marca, linha, compressão, modelo, cor e ponteira</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-6 lg:py-12">
      <CompressionLineCatalog brands={compressionStockingBrands} />
    </section>
  </main>

  <footer class="border-t bg-secondary">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p class="text-sm text-muted-foreground">
        Casa do Médico BH — catálogo institucional com atendimento consultivo pelo WhatsApp.
      </p>
      <img src="/logo/casa-do-medico-pb.png" alt="" class="h-10 w-auto opacity-60" />
    </div>
  </footer>
</Layout>
