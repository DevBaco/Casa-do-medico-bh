---
import { Mail, Star } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import { GOOGLE_REVIEW_EVENT, GOOGLE_REVIEW_URL } from "@/lib/google";
import { WHATSAPP_URL } from "@/lib/whatsapp";
---

<footer class="border-t bg-background">
  <div class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-[1.1fr_0.7fr_0.7fr_0.9fr]">
    <div>
      <img
        src="/images/home/logo-casa-do-medico-wordmark.webp"
        alt="Casa do Médico BH"
        width="520"
        height="240"
        loading="lazy"
        class="h-12 w-auto"
      />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted-foreground">
        Produtos médicos, ortopédicos e meias de compressão com atendimento próximo desde 1954.
      </p>
      <div class="mt-4 flex gap-2">
        <a
          href="https://www.instagram.com/casadomedico_/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram da Casa do Médico BH"
          class={buttonVariants({ variant: "outline", size: "icon-sm" })}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
            <path d="M12 2c-2.72 0-3.06.01-4.12.06-1.06.05-1.79.22-2.43.47-.66.26-1.22.6-1.77 1.16a4.9 4.9 0 0 0-1.16 1.77c-.25.64-.42 1.37-.47 2.43C2 8.94 2 9.28 2 12c0 2.72.01 3.06.06 4.12.05 1.06.22 1.79.47 2.43.26.66.6 1.22 1.16 1.77.55.56 1.11.9 1.77 1.16.64.25 1.37.42 2.43.47C8.94 22 9.28 22 12 22c2.72 0 3.06-.01 4.12-.06 1.06-.05 1.79-.22 2.43-.47.66-.26 1.22-.6 1.77-1.16.56-.55.9-1.11 1.16-1.77.25-.64.42-1.37.47-2.43.05-1.06.06-1.4.06-4.12 0-2.72-.01-3.06-.06-4.12-.05-1.06-.22-1.79-.47-2.43a4.9 4.9 0 0 0-1.16-1.77 4.9 4.9 0 0 0-1.77-1.16c-.64-.25-1.37-.42-2.43-.47C15.06 2.01 14.72 2 12 2Zm0 1.8c2.67 0 2.99.01 4.04.06.98.04 1.5.21 1.86.34.47.18.8.4 1.15.75.35.35.57.68.75 1.15.13.36.3.88.34 1.86.05 1.05.06 1.37.06 4.04 0 2.67-.01 2.99-.06 4.04-.04.98-.21 1.5-.34 1.86-.18.47-.4.8-.75 1.15-.35.35-.68.57-1.15.75-.36.13-.88.3-1.86.34-1.05.05-1.37.06-4.04.06-2.67 0-2.99-.01-4.04-.06-.98-.04-1.5-.21-1.86-.34a3.1 3.1 0 0 1-1.15-.75 3.1 3.1 0 0 1-.75-1.15c-.13-.36-.3-.88-.34-1.86C3.81 14.99 3.8 14.67 3.8 12c0-2.67.01-2.99.06-4.04.04-.98.21-1.5.34-1.86.18-.47.4-.8.75-1.15.35-.35.68-.57 1.15-.75.36-.13.88-.3 1.86-.34C9.01 3.81 9.33 3.8 12 3.8Zm0 3.06a5.14 5.14 0 1 0 0 10.28 5.14 5.14 0 0 0 0-10.28Zm0 8.48a3.34 3.34 0 1 1 0-6.68 3.34 3.34 0 0 1 0 6.68Zm5.34-8.68a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"/>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=100090896740956"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook da Casa do Médico BH"
          class={buttonVariants({ variant: "outline", size: "icon-sm" })}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"/>
          </svg>
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp da Casa do Médico BH"
          class={buttonVariants({ variant: "outline", size: "icon-sm" })}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
            <path d="M12.04 2a9.84 9.84 0 0 0-9.87 9.82c0 1.73.45 3.42 1.3 4.9L2.08 21.8l5.2-1.36a9.9 9.9 0 0 0 4.75 1.2h.01a9.84 9.84 0 0 0 9.87-9.82c0-2.62-1.03-5.09-2.9-6.94A9.84 9.84 0 0 0 12.04 2Zm0 17.98h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.08.81.82-2.99-.2-.31a8.1 8.1 0 0 1-1.26-4.35 8.2 8.2 0 0 1 8.22-8.17c2.2 0 4.27.85 5.82 2.4a8.1 8.1 0 0 1 2.41 5.78 8.2 8.2 0 0 1-8.24 8.15Zm4.5-6.13c-.25-.12-1.46-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.04-.39-1.99-1.23a7.45 7.45 0 0 1-1.38-1.71c-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.02 2.58c.12.16 1.76 2.67 4.26 3.75.6.25 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.08 1.46-.6 1.67-1.17.2-.58.2-1.07.14-1.17-.06-.1-.23-.17-.48-.29Z"/>
          </svg>
        </a>
        <a
          href="mailto:bramelbrasilmedica@gmail.com"
          aria-label="E-mail da Casa do Médico BH"
          class={buttonVariants({ variant: "outline", size: "icon-sm" })}
        >
          <Mail className="size-4" />
        </a>
        <a
          href={GOOGLE_REVIEW_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-review-cta
          aria-label="Avaliar a Casa do Médico BH no Google"
          title="Avaliar a Casa do Médico no Google"
          class={buttonVariants({ variant: "outline", size: "icon-sm" })}
        >
          <Star className="size-4" />
        </a>
      </div>
    </div>
    <div>
      <h2 class="text-sm font-semibold">Catálogos</h2>
      <nav class="mt-3 grid gap-2 text-sm text-muted-foreground" aria-label="Links de catálogo no rodapé">
        <a href="/produtos" class="hover:text-primary">Produtos médicos e ortopédicos</a>
        <a href="/meias-de-compressão" class="hover:text-primary">Meias de compressão</a>
        <a href="/#categorias" class="hover:text-primary">Categorias</a>
      </nav>
    </div>
    <div>
      <h2 class="text-sm font-semibold">Casa do Médico BH</h2>
      <nav class="mt-3 grid gap-2 text-sm text-muted-foreground" aria-label="Links institucionais no rodapé">
        <a href="/#nossa-historia" class="hover:text-primary">Nossa história</a>
        <a href="/contato" class="hover:text-primary">Contato e localização</a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="hover:text-primary">WhatsApp</a>
      </nav>
    </div>
    <div>
      <h2 class="text-sm font-semibold">Contato</h2>
      <div class="mt-3 grid gap-2 text-sm text-muted-foreground">
        <a href="tel:+553132244407" class="hover:text-primary">(31) 3224-4407</a>
        <a href="mailto:bramelbrasilmedica@gmail.com" class="break-all hover:text-primary">bramelbrasilmedica@gmail.com</a>
      </div>
    </div>
  </div>
  <Separator />
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-2 px-5 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {new Date().getFullYear()} Casa do Médico BH. Todos os direitos reservados.</p>
    <p>Av. Afonso Pena, 981 · Belo Horizonte/MG</p>
  </div>
</footer>

{/* Registra no Google Analytics todo clique nos botões de avaliação (bloco e rodapé). */}
<script is:inline define:vars={{ GOOGLE_REVIEW_EVENT }}>
  document.addEventListener("click", (event) => {
    const trigger = event.target.closest?.("[data-review-cta]");

    if (!trigger) return;

    window.gtag?.("event", GOOGLE_REVIEW_EVENT, {
      link_url: trigger.href,
      link_text: trigger.textContent?.trim() || trigger.getAttribute("aria-label"),
    });
  });
</script>
