---
import { Star } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { GOOGLE_REVIEW_URL } from "@/lib/google";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("mt-8 border-t border-background/20 pt-7", className)}>
  <div class="flex gap-1 text-accent" aria-hidden="true">
    {Array.from({ length: 5 }).map(() => <Star className="size-4 fill-current" />)}
  </div>
  <h3 class="mt-3 text-xl font-semibold tracking-tight text-balance sm:text-2xl">
    Como foi sua experiência com a Casa do Médico?
  </h3>
  <p class="mt-3 leading-relaxed text-pretty text-background/70">
    Sua opinião é muito importante para nós e ajuda outras pessoas de Belo Horizonte a encontrarem
    atendimento especializado e produtos médicos com mais confiança. Conte como foi sua experiência
    com a Casa do Médico.
  </p>
  <a
    href={GOOGLE_REVIEW_URL}
    target="_blank"
    rel="noopener noreferrer"
    data-review-cta
    class={cn(buttonVariants({ size: "lg" }), "mt-5 h-11 gap-2 rounded-full px-5")}
  >
    <img src="/icons/google.svg" alt="" class="size-4" />
    Avaliar a Casa do Médico no Google
  </a>
</div>
