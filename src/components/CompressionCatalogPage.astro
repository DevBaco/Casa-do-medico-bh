---
import CatalogSearchEngine from "@/components/CatalogSearchEngine.astro";
import CatalogReturnMemory from "@/components/CatalogReturnMemory.astro";
import CompressionCatalog from "@/components/CompressionCatalog.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { compressionStockingBrands, getCompressionLineKey } from "@/data/compression-stockings";
import Layout from "@/layouts/Layout.astro";

interface Props {
  brandId?: string;
  lineKey?: string;
}

const { brandId, lineKey } = Astro.props;
const selectedBrand = compressionStockingBrands.find((brand) => brand.id === brandId);
const selectedLine = selectedBrand?.lines.find(
  (line) => getCompressionLineKey(line.line) === lineKey
)?.line;

const heading = selectedLine
  ? `Meias compressivas ${selectedBrand?.name} · ${selectedLine}`
  : selectedBrand
    ? `Meias compressivas ${selectedBrand.name}`
    : "Catálogo de meias compressivas Venosan, Sigvaris e Genoven";

const title = selectedLine
  ? `${selectedBrand?.name} ${selectedLine} em BH · Casa do Médico BH`
  : selectedBrand
    ? `Meias Compressivas ${selectedBrand.name} em BH · Casa do Médico BH`
    : "Meias de compressão | Casa Do Medico Bh";

const description = selectedLine
  ? `Conheça as meias compressivas ${selectedBrand?.name} da linha ${selectedLine}. Consulte modelos, tamanhos e disponibilidade em Belo Horizonte.`
  : selectedBrand
    ? `Catálogo de meias compressivas ${selectedBrand.name} em Belo Horizonte. Consulte linhas, modelos, compressões e tamanhos pelo WhatsApp.`
    : "Encontre meias de compressão e meias elásticas Sigvaris e Venosan em Belo Horizonte na Casa do Médico BH. Loja tradicional desde 1954 com atendimento especializado.";
---

<Layout title={title} description={description}>
  <SiteHeader />

  <main>
    <h1 class="sr-only">{heading}</h1>
    <section class="mx-auto w-full max-w-7xl px-5 py-6 sm:px-6 lg:py-8">
      <CompressionCatalog brandId={brandId} lineKey={lineKey} />
    </section>
  </main>

  <SiteFooter />
  <CatalogReturnMemory />
  <CatalogSearchEngine />
</Layout>
