---
import { Search, X } from "lucide-react";

interface Props {
  placeholder: string;
  /** Debug/aria label for the field. */
  label: string;
}

const { placeholder, label } = Astro.props;
---

<div
  class="mx-auto w-full max-w-2xl"
  data-catalog-search-root
>
  <div class="relative">
    <Search className="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-muted-foreground" />
    <input
      data-catalog-search
      type="text"
      inputmode="search"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      aria-label={label}
      placeholder={placeholder}
      class="h-12 w-full rounded-lg border bg-background pr-10 pl-11 text-base shadow-sm outline-none transition-[box-shadow,border-color] placeholder:text-muted-foreground focus-visible:border-primary focus-visible:ring-3 focus-visible:ring-primary/20"
    />
    <button
      type="button"
      data-catalog-search-clear
      hidden
      aria-label="Limpar busca"
      class="absolute top-1/2 right-2 grid size-6 -translate-y-1/2 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <X className="size-3.5" />
    </button>
  </div>
  <p
    data-catalog-search-feedback
    class="mt-2 min-h-4 text-center text-xs text-muted-foreground"
    aria-live="polite"
  ></p>
</div>
