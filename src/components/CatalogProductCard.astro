---
import { ArrowRight } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  getCatalogCategory,
  getCatalogProductPath,
  type CatalogProduct,
} from "@/data/catalog-products";
import { catalogSubcategories, getCatalogPopularFilterIds } from "@/data/catalog-filters";
import { storeBrands } from "@/data/brands";
import { buildSearchText, normalizeSearchText } from "@/lib/catalog-search";
import { buildCatalogProductWhatsAppUrl } from "@/lib/whatsapp";
import { cn } from "@/lib/utils";

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;
const category = getCatalogCategory(product.categoryId);

// Searchable haystack: what someone would plausibly type looking for this
// product, including the groupings it sits under and the brands we carry it in.
const subcategoryLabels = getCatalogPopularFilterIds(product.id).map(
  (filterId) =>
    catalogSubcategories.find((subcategory) => subcategory.id === filterId)?.label ?? ""
);
const brandNames = product.brandIds.map(
  (brandId) => storeBrands.find((brand) => brand.id === brandId)?.name ?? ""
);
const searchName = normalizeSearchText(product.name);
const searchText = buildSearchText([
  product.name,
  product.summary,
  product.badges,
  product.keywords,
  product.highlights,
  subcategoryLabels,
  brandNames,
  category.name,
  category.shortName,
]);
const href = getCatalogProductPath(product);
const whatsappUrl = buildCatalogProductWhatsAppUrl(product.name);
const catalogImageStyle = `transform: translateX(${product.imageFrame?.catalogTranslateX ?? 0}%) scale(${product.imageFrame?.catalogScale ?? 1});`;
const hasMultipleImages = product.images.length > 1;
const hasColorOptions = Boolean(product.colorOptions?.length);
const swatchClass = {
  clear: "bg-product-swatch-clear",
  amber: "bg-product-swatch-amber",
  white: "bg-product-swatch-white",
  black: "bg-product-swatch-black",
} as const;
---

<Card
  id={product.id}
  data-catalog-item
  data-search-name={searchName}
  data-search-text={searchText}
  className="group product-card h-full scroll-mt-24 gap-0 overflow-hidden rounded-lg p-0 transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg"
>
  <a
    href={href}
    data-product-detail-link
    class="group/media relative flex aspect-[5/4] w-full snap-x snap-mandatory overflow-x-auto bg-white [scrollbar-width:none] md:grid md:place-items-center md:overflow-hidden [&::-webkit-scrollbar]:hidden"
    aria-label={`Ver detalhes de ${product.name}`}
  >
    <span data-product-images class="contents">
      {product.images.map((image, index) => (
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
          data-image-brand={image.brandId ?? ""}
          data-image-color={image.colorSwatch ?? ""}
          class:list={[
            "h-full w-full shrink-0 snap-center object-contain object-center transition-opacity duration-200 md:absolute md:inset-0",
            hasColorOptions && "absolute inset-0 opacity-0",
            !hasColorOptions && index === 0 && hasMultipleImages && "md:group-hover/media:opacity-0",
            !hasColorOptions && index === 1 && "md:opacity-0 md:group-hover/media:opacity-100",
            index > 1 && "md:hidden",
          ]}
          style={index === 0 ? catalogImageStyle : undefined}
        />
      ))}
      {hasMultipleImages && (
        <span class="pointer-events-none absolute right-3 bottom-3 flex gap-1.5 md:hidden" aria-hidden="true">
          {product.images.map((_, index) => (
            <span class:list={["size-1.5 rounded-full", index === 0 ? "bg-primary" : "bg-border"]}></span>
          ))}
        </span>
      )}
    </span>

    <span class="absolute right-3 bottom-3 hidden rounded-md border bg-background/95 px-2.5 py-1 text-xs font-semibold text-primary opacity-0 shadow-sm transition-opacity group-hover/media:opacity-100 md:block">
      Ver produto
    </span>
  </a>

  <CardContent className="flex min-h-[310px] flex-1 flex-col gap-3 border-t p-4 sm:p-5">
    {product.colorOptions && (
      <fieldset
        class="flex flex-wrap gap-1.5"
        aria-label={`Cores disponíveis: ${product.colorOptions.map((color) => color.label).join(", ")}`}
      >
        <legend class="sr-only">Selecione uma cor</legend>
        {product.colorOptions.map((color, index) => (
          <label class="group/swatch cursor-pointer">
            <input
              class="sr-only"
              type="radio"
              name={`${product.id}-color`}
              value={color.swatch}
              checked={index === 0}
            />
            <span
              class:list={[
                "block size-4.5 shrink-0 rounded-full border border-black/10 shadow-sm transition-transform group-hover/swatch:scale-125 group-has-[:checked]/swatch:ring-2 group-has-[:checked]/swatch:ring-primary group-has-[:checked]/swatch:ring-offset-2",
                swatchClass[color.swatch],
              ]}
              title={color.label}
            ></span>
            <span class="sr-only">{color.label}</span>
          </label>
        ))}
      </fieldset>
    )}

    <div class="flex flex-wrap gap-2">
      <Badge variant="outline">{category.shortName}</Badge>
      {product.badges.slice(0, 1).map((badge) => (
        <Badge variant="secondary">{badge}</Badge>
      ))}
    </div>

    <div>
      <a href={href} data-product-detail-link class="hover:text-primary">
        <h3 class="text-lg font-semibold leading-snug">{product.name}</h3>
      </a>
      <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">
        {product.summary}
      </p>
    </div>

    <p class="mt-auto text-sm font-semibold text-primary">Consulte disponibilidade</p>

    <div class="grid gap-2 sm:grid-cols-2">
      <a
        href={href}
        data-product-detail-link
        class={cn(buttonVariants({ variant: "outline", size: "lg" }), "w-full")}
      >
        Ver detalhes
        <ArrowRight className="size-4" />
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={cn(buttonVariants({ size: "lg" }), "w-full")}
      >
        <img src="/icons/whatsapp.svg" alt="" class="size-4" />
        WhatsApp
      </a>
    </div>
  </CardContent>
</Card>

<style>
  .product-card:has(input[value="clear"]:checked) [data-image-color="clear"],
  .product-card:has(input[value="amber"]:checked) [data-image-color="amber"],
  .product-card:has(input[value="white"]:checked) [data-image-color="white"],
  .product-card:has(input[value="black"]:checked) [data-image-color="black"] {
    opacity: 1;
  }
</style>
