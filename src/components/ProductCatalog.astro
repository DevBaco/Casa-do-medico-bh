---
import { ArrowLeft, ArrowRight, ChevronDown, Search, SlidersHorizontal, X } from "lucide-react";
import CatalogProductCard from "@/components/CatalogProductCard.astro";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  catalogSubcategories,
  getCatalogPopularFilterIds,
} from "@/data/catalog-filters";
import {
  catalogCategories,
  catalogProducts,
} from "@/data/catalog-products";
import type { CatalogCategoryId } from "@/data/catalog-products";
import { cn } from "@/lib/utils";

interface Props {
  initialCategory?: CatalogCategoryId;
}

const { initialCategory = "" } = Astro.props;
const initialCategoryDetails = catalogCategories.find(
  (category) => category.id === initialCategory
);
const validInitialCategory = initialCategoryDetails?.id ?? "";
const initialProductCount = validInitialCategory
  ? catalogProducts.filter((product) => product.categoryId === validInitialCategory).length
  : catalogProducts.length;

const primarySubcategoryByProductId = new Map<string, string>();
for (const subcategory of catalogSubcategories) {
  for (const productId of subcategory.productIds) {
    if (!primarySubcategoryByProductId.has(productId)) {
      primarySubcategoryByProductId.set(productId, subcategory.id);
    }
  }
}

const groupedCatalogCategories = catalogCategories.map((category) => {
  const subcategories = catalogSubcategories
    .filter((subcategory) => subcategory.categoryId === category.id)
    .map((subcategory) => ({
      ...subcategory,
      products: catalogProducts.filter(
        (product) =>
          product.categoryId === category.id &&
          primarySubcategoryByProductId.get(product.id) === subcategory.id
      ),
    }))
    .filter((subcategory) => subcategory.products.length > 0);

  const uncategorizedProducts = catalogProducts.filter(
    (product) =>
      product.categoryId === category.id &&
      !primarySubcategoryByProductId.has(product.id)
  );

  return {
    category,
    subcategories,
    uncategorizedProducts,
  };
});

---

<div
  class="space-y-8"
  data-product-catalog
  data-initial-category={validInitialCategory}
>
  <a
    data-catalog-all-link
    href="/produtos"
    hidden={!validInitialCategory}
    class={cn(buttonVariants({ variant: "outline", size: "sm" }), "inline-flex")}
  >
    <ArrowLeft className="size-3.5" />
    Voltar ao catálogo completo
  </a>

  <Card className="gap-0 overflow-hidden py-0 shadow-sm">
    <CardContent className="p-0">
      <div class="flex flex-col gap-5 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="flex min-w-0 items-center gap-4">
          <div
            data-default-catalog-mark
            class="grid size-14 shrink-0 place-items-center rounded-lg border bg-white p-1.5"
          >
            <img
              src="/logo/casa-do-medico.png"
              alt="Casa do Médico"
              class="size-full object-contain"
            />
          </div>

          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <Badge data-active-type-badge className="hidden">
                <span data-active-type-label></span>
              </Badge>
              <Badge
                data-active-category-badge
                className={initialCategoryDetails ? "" : "hidden"}
              >
                <span data-active-category-label>{initialCategoryDetails?.shortName}</span>
              </Badge>
            </div>
            <h2 data-catalog-heading class="mt-2 text-xl font-semibold sm:text-2xl">
              {initialCategoryDetails?.name ?? "Todos os produtos"}
            </h2>
            <p data-catalog-count class="mt-1 text-sm text-muted-foreground">
              {initialProductCount} {initialProductCount === 1 ? "produto" : "produtos"} no catálogo
            </p>
          </div>
        </div>
      </div>

      <details class="group border-t">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-3.5 transition-colors hover:bg-secondary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:px-6 [&::-webkit-details-marker]:hidden">
          <span class="flex min-w-0 items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
              <SlidersHorizontal className="size-4" />
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold">Filtrar o catálogo</span>
              <span data-filter-summary class="block truncate text-xs text-muted-foreground">
                {initialCategoryDetails?.shortName ?? "Todas as categorias"}
              </span>
            </span>
          </span>
          <ChevronDown className="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" />
        </summary>

        <div class="space-y-5 border-t bg-secondary/40 px-5 py-5 sm:px-6">
          <fieldset>
            <legend class="mb-2.5 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
              Categoria
            </legend>
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                data-filter-category=""
                aria-pressed={String(!validInitialCategory)}
                class={cn(
                  buttonVariants({ variant: "outline", size: "sm" }),
                  "rounded-full aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
                )}
              >
                Todas
              </button>
              {catalogCategories.map((category) => (
                <button
                  type="button"
                  data-filter-category={category.id}
                  data-category-name={category.name}
                  aria-pressed={String(category.id === validInitialCategory)}
                  class={cn(
                    buttonVariants({ variant: "outline", size: "sm" }),
                    "rounded-full aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
                  )}
                >
                  {category.shortName}
                </button>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend class="mb-2.5 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
              Tipo de produto
            </legend>
            <div class="grid gap-5 lg:grid-cols-2">
              {catalogCategories.map((category) => (
                <div
                  data-filter-type-group
                  data-category-scope={category.id}
                  hidden={Boolean(validInitialCategory && category.id !== validInitialCategory)}
                >
                  <p class="mb-2 text-sm font-semibold">{category.shortName}</p>
                  <div class="flex flex-wrap gap-2">
                    <button
                      type="button"
                      data-filter-type=""
                      data-category-scope={category.id}
                      aria-pressed="false"
                      class={cn(
                        buttonVariants({ variant: "outline", size: "sm" }),
                        "h-auto min-h-8 rounded-full whitespace-normal aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
                      )}
                    >
                      Todos
                    </button>
                    {catalogSubcategories
                      .filter((subcategory) => subcategory.categoryId === category.id)
                      .map((subcategory) => (
                        <button
                          type="button"
                          data-filter-type={subcategory.id}
                          data-category-scope={subcategory.categoryId}
                          aria-pressed="false"
                          title={subcategory.description}
                          class={cn(
                            buttonVariants({ variant: "outline", size: "sm" }),
                            "h-auto min-h-8 rounded-full whitespace-normal aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
                          )}
                        >
                          {subcategory.label}
                        </button>
                      ))}
                  </div>
                </div>
              ))}
            </div>
          </fieldset>

          <button
            type="button"
            data-clear-filters
            hidden={!validInitialCategory}
            class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "px-0 text-muted-foreground")}
          >
            <X className="size-3.5" />
            Limpar filtros
          </button>

          <p data-catalog-search-status class="sr-only" aria-live="polite"></p>
        </div>
      </details>
    </CardContent>
  </Card>

  <Card className="border-primary/20 bg-secondary/45">
    <CardContent className="flex flex-col gap-5 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div>
        <Badge variant="secondary">Meias compressivas</Badge>
        <h2 class="mt-2 text-lg font-semibold">Também procura meias de compressão?</h2>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
          Explore as linhas disponíveis e encontre a opção mais adequada para sua necessidade.
        </p>
      </div>
      <a href="/meias-de-compressão" class={cn(buttonVariants({ variant: "outline", size: "lg" }), "shrink-0")}>
        Ver catálogo de meias
        <ArrowRight className="size-4" />
      </a>
    </CardContent>
  </Card>

  <div data-catalog-grid class="space-y-10">
    {groupedCatalogCategories.map(({ category, subcategories, uncategorizedProducts }) => (
      <section
        data-catalog-category-block
        data-category-id={category.id}
        hidden={Boolean(validInitialCategory && category.id !== validInitialCategory)}
        class="space-y-6"
      >
        <div class="space-y-2">
          <Badge variant="secondary">{category.shortName}</Badge>
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{category.name}</h2>
          <p class="max-w-3xl text-sm text-muted-foreground">{category.description}</p>
        </div>

        <div class="space-y-8">
          {subcategories.map((subcategory) => (
            <section
              data-catalog-subcategory-block
              data-category-id={category.id}
              data-subcategory-id={subcategory.id}
              hidden={Boolean(validInitialCategory && category.id !== validInitialCategory)}
              class="space-y-4"
            >
              <div class="space-y-1">
                <h3 class="text-lg font-semibold">{subcategory.label}</h3>
                <p class="text-sm text-muted-foreground">{subcategory.description}</p>
              </div>

              <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                {subcategory.products.map((product) => (
                  <div
                    data-product-card
                    data-category={product.categoryId}
                    data-types={getCatalogPopularFilterIds(product.id).join(" ")}
                    data-subcategory-id={subcategory.id}
                    hidden={Boolean(validInitialCategory && product.categoryId !== validInitialCategory)}
                  >
                    <CatalogProductCard product={product} />
                  </div>
                ))}
              </div>
            </section>
          ))}

          {uncategorizedProducts.length > 0 && (
            <section
              data-catalog-subcategory-block
              data-category-id={category.id}
              data-subcategory-id=""
              hidden={Boolean(validInitialCategory && category.id !== validInitialCategory)}
              class="space-y-4"
            >
              <div class="space-y-1">
                <h3 class="text-lg font-semibold">Outros</h3>
                <p class="text-sm text-muted-foreground">
                  Produtos desta categoria que não entram em uma subcategoria específica.
                </p>
              </div>

              <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                {uncategorizedProducts.map((product) => (
                  <div
                    data-product-card
                    data-category={product.categoryId}
                    data-types={getCatalogPopularFilterIds(product.id).join(" ")}
                    data-subcategory-id=""
                    hidden={Boolean(validInitialCategory && product.categoryId !== validInitialCategory)}
                  >
                    <CatalogProductCard product={product} />
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      </section>
    ))}
  </div>

  <Card data-catalog-empty className="hidden border-dashed">
    <CardContent className="py-12 text-center">
      <Search className="mx-auto size-8 text-muted-foreground" />
      <h2 class="mt-4 text-xl font-semibold">Nenhum produto encontrado</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Remova algum filtro ou selecione outra categoria.
      </p>
    </CardContent>
  </Card>

  <section data-catalog-related hidden class="border-t pt-10 sm:pt-14">
    <div class="mb-6 max-w-3xl">
      <Badge variant="secondary">Continue explorando</Badge>
      <h2 class="mt-3 text-2xl font-bold sm:text-3xl">Produtos relacionados</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Outros itens que podem complementar sua escolha.
      </p>
    </div>
    <div data-catalog-related-grid class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3"></div>
  </section>
</div>

<script is:inline>
  // Runs inline and synchronously (not as a bundled module fetched over the
  // network) so the initial category/type filter from the URL
  // is applied to the DOM before the browser's first paint. A bundled
  // `type="module"` script is fetched async and only ever runs after the
  // unfiltered grid has already painted, producing a visible flash of every
  // product before narrowing down to the filtered set.
  var catalogRoot = document.querySelector("[data-product-catalog]");

  if (catalogRoot) {
    var productCards = Array.from(
      catalogRoot.querySelectorAll("[data-product-card]")
    );
    var productDetailLinks = Array.from(
      catalogRoot.querySelectorAll("[data-product-detail-link]")
    );
    var categoryBlocks = Array.from(
      catalogRoot.querySelectorAll("[data-catalog-category-block]")
    );
    var subcategoryBlocks = Array.from(
      catalogRoot.querySelectorAll("[data-catalog-subcategory-block]")
    );
    var categoryButtons = Array.from(
      catalogRoot.querySelectorAll("[data-filter-category]")
    );
    var typeButtons = Array.from(
      catalogRoot.querySelectorAll("[data-filter-type]")
    );
    var typeGroups = Array.from(
      catalogRoot.querySelectorAll("[data-filter-type-group]")
    );
    var clearButton = catalogRoot.querySelector("[data-clear-filters]");
    var heading = catalogRoot.querySelector("[data-catalog-heading]");
    var count = catalogRoot.querySelector("[data-catalog-count]");
    var filterSummary = catalogRoot.querySelector("[data-filter-summary]");
    var emptyState = catalogRoot.querySelector("[data-catalog-empty]");
    var catalogAllLink = catalogRoot.querySelector("[data-catalog-all-link]");
    var relatedSection = catalogRoot.querySelector("[data-catalog-related]");
    var relatedGrid = catalogRoot.querySelector("[data-catalog-related-grid]");
    var searchStatus = catalogRoot.querySelector("[data-catalog-search-status]");
    var categoryBadge = catalogRoot.querySelector("[data-active-category-badge]");
    var categoryLabel = catalogRoot.querySelector("[data-active-category-label]");
    var typeBadge = catalogRoot.querySelector("[data-active-type-badge]");
    var typeLabel = catalogRoot.querySelector("[data-active-type-label]");
    var defaultMark = catalogRoot.querySelector("[data-default-catalog-mark]");
    var initialCategory = catalogRoot.dataset.initialCategory || "";

    // The server renders two different labels per category: the chip's own
    // short name (used for the active badge and the "Filtrar o catálogo"
    // summary line) and a longer descriptive name (used for the <h2>). Keep
    // both here so the script's initial re-render matches exactly what was
    // server-rendered for each spot — using only one of them would recompute
    // the other elements with a different string right as this script
    // applies state, producing a visible text swap.
    var categories = new Map(
      categoryButtons
        .filter(function (button) { return button.dataset.filterCategory; })
        .map(function (button) {
          var short = (button.textContent || "").trim();
          var long = button.dataset.categoryName || short;
          return [button.dataset.filterCategory || "", { short: short, long: long }];
        })
    );
    var types = new Map(
      typeButtons
        .filter(function (button) { return button.dataset.filterType; })
        .map(function (button) { return [button.dataset.filterType || "", (button.textContent || "").trim()]; })
    );
    var typeCategoryById = new Map(
      typeButtons
        .filter(function (button) { return button.dataset.filterType; })
        .map(function (button) {
          return [button.dataset.filterType || "", button.dataset.categoryScope || ""];
        })
    );

    var state = { category: "", type: "" };
    var relatedCategoriesById = {
      "monitoramento": ["cuidados-medico-hospitalares", "ortopedia-mobilidade"],
      "ortopedia-mobilidade": ["fisioterapia-recuperacao", "cuidados-medico-hospitalares"],
      "fisioterapia-recuperacao": ["ortopedia-mobilidade"],
      "cuidados-medico-hospitalares": ["monitoramento", "ortopedia-mobilidade"],
    };

    var readUrlState = function () {
      var params = new URLSearchParams(window.location.search);
      var hasCategoryParam = params.has("categoria");
      var category = params.get("categoria") || "";
      var type = params.get("tipo") || "";

      // When there's no explicit ?categoria= in the URL (e.g. the static
      // /produtos/categoria/[category] pages, which encode the category in
      // the path instead), fall back to the server-rendered initialCategory
      // rather than treating the absence of the param as "all categories".
      // categories.has("") is always true (the "Todas" button is keyed by
      // ""), so it can't be used to detect whether the param was present.
      if (hasCategoryParam) {
        state.category = categories.has(category) ? category : "";
      } else {
        state.category = categories.has(initialCategory) ? initialCategory : "";
      }
      state.type = types.has(type) ? type : "";
      if (state.type) {
        state.category = typeCategoryById.get(state.type) || state.category;
      }
    };

    var writeUrlState = function () {
      var url = new URL(window.location.href);

      if (url.pathname.indexOf("/produtos/categoria/") === 0) {
        url.pathname = "/produtos";
      }

      if (state.category) url.searchParams.set("categoria", state.category);
      else url.searchParams.delete("categoria");
      if (state.type) url.searchParams.set("tipo", state.type);
      else url.searchParams.delete("tipo");
      url.searchParams.delete("marca");
      url.searchParams.delete("busca");

      window.history.replaceState({}, "", url.pathname + url.search + url.hash);
    };

    var updateProductDetailLinks = function () {
      var returnTo = window.location.pathname + window.location.search + window.location.hash;
      var hasFilterState = Boolean(state.category || state.type);

      productDetailLinks.forEach(function (link) {
        var productUrl = link.dataset.productUrl || link.getAttribute("href") || "";
        if (!link.dataset.productUrl) link.dataset.productUrl = productUrl;
        link.setAttribute(
          "href",
          hasFilterState
            ? productUrl + "?retorno=" + encodeURIComponent(returnTo)
            : productUrl
        );
      });
    };

    var updateRelatedProducts = function () {
      if (!relatedSection || !relatedGrid || !state.category) {
        if (relatedSection) relatedSection.hidden = true;
        return;
      }

      var relatedCategoryIds = relatedCategoriesById[state.category] || [];
      var candidates = productCards.filter(function (card) {
        var types = (card.dataset.types || "").split(" ");
        return state.type
          ? card.dataset.category === state.category && !types.includes(state.type)
          : relatedCategoryIds.includes(card.dataset.category || "");
      }).slice(0, 3);

      relatedGrid.replaceChildren();
      candidates.forEach(function (card) {
        var relatedCard = card.cloneNode(true);
        relatedCard.removeAttribute("id");
        relatedCard.removeAttribute("hidden");
        relatedCard.removeAttribute("data-product-card");
        relatedCard.querySelectorAll("[id]").forEach(function (element) {
          element.removeAttribute("id");
        });
        relatedCard.querySelectorAll("input[name]").forEach(function (input) {
          input.name = "related-" + input.name;
        });
        relatedGrid.appendChild(relatedCard);
      });
      relatedSection.hidden = candidates.length === 0;
    };

    var applyState = function (updateUrl) {
      if (updateUrl === undefined) updateUrl = true;

      var categoryNames = categories.get(state.category) || { short: "", long: "" };
      var categoryShortName = categoryNames.short;
      var categoryLongName = categoryNames.long;
      var typeName = types.get(state.type) || "";
      var visibleProducts = 0;

      productCards.forEach(function (element) {
        var matchesCategory =
          !state.category || element.dataset.category === state.category;
        var matchesType =
          !state.type || (element.dataset.types || "").split(" ").includes(state.type);
        var visible = matchesCategory && matchesType;

        element.hidden = !visible;
        if (visible) visibleProducts += 1;

      });

      subcategoryBlocks.forEach(function (block) {
        var blockCategory = block.dataset.categoryId || "";
        var visibleCards = block.querySelectorAll("[data-product-card]:not([hidden])");
        block.hidden = !visibleCards.length || (state.category && blockCategory !== state.category);
      });
      categoryBlocks.forEach(function (block) {
        var visibleCards = block.querySelectorAll("[data-product-card]:not([hidden])");
        block.hidden = !visibleCards.length;
      });

      categoryButtons.forEach(function (button) {
        button.setAttribute(
          "aria-pressed",
          String((button.dataset.filterCategory || "") === state.category)
        );
      });
      typeButtons.forEach(function (button) {
        var buttonType = button.dataset.filterType || "";
        var buttonCategory = button.dataset.categoryScope || "";
        button.setAttribute(
          "aria-pressed",
          String(
            buttonType === state.type &&
            (Boolean(buttonType) || buttonCategory === state.category)
          )
        );
      });
      typeGroups.forEach(function (group) {
        group.hidden = Boolean(
          state.category && group.dataset.categoryScope !== state.category
        );
      });

      if (defaultMark) defaultMark.hidden = false;

      if (categoryLabel) categoryLabel.textContent = categoryShortName;
      if (categoryBadge) categoryBadge.classList.toggle("hidden", !categoryShortName);
      if (typeLabel) typeLabel.textContent = typeName;
      if (typeBadge) typeBadge.classList.toggle("hidden", !typeName);

      if (heading) {
        var productGroupName = typeName || categoryLongName;
        heading.textContent = productGroupName || "Todos os produtos";
      }

      if (count) {
        count.textContent = visibleProducts + " " + (visibleProducts === 1 ? "produto" : "produtos") + " no catálogo";
      }

      if (filterSummary) {
        filterSummary.textContent = typeName || categoryShortName || "Todas as categorias";
      }

      var hasActiveFilter = Boolean(state.category || state.type);
      if (clearButton) clearButton.hidden = !hasActiveFilter;
      if (catalogAllLink) catalogAllLink.hidden = !Boolean(state.category || state.type);
      if (emptyState) emptyState.classList.toggle("hidden", visibleProducts !== 0);

      if (searchStatus) {
        searchStatus.textContent = visibleProducts === 0
          ? "Nenhum produto encontrado"
          : visibleProducts + " " + (visibleProducts === 1 ? "produto encontrado" : "produtos encontrados");
      }

      if (updateUrl) writeUrlState();
      updateProductDetailLinks();
      updateRelatedProducts();
    };

    categoryButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        state.category = button.dataset.filterCategory || "";
        if (state.type && typeCategoryById.get(state.type) !== state.category) {
          state.type = "";
        }
        applyState();
      });
    });

    typeButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        state.type = button.dataset.filterType || "";
        if (button.dataset.categoryScope) {
          state.category = button.dataset.categoryScope;
        }
        applyState();
      });
    });

    if (clearButton) {
      clearButton.addEventListener("click", function () {
        state.category = "";
        state.type = "";
        applyState();
      });
    }

    window.addEventListener("popstate", function () {
      readUrlState();
      applyState(false);
    });

    // Apply the URL-derived filter synchronously, in the same task that
    // parsed the grid above, so the browser never gets a chance to paint
    // the unfiltered list first.
    readUrlState();
    applyState(false);
  }
</script>
