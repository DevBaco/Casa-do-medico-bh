---
import SiteHeaderClient from "@/components/SiteHeaderClient";
import { MapPin, Phone } from "lucide-react";
import {
  catalogSubcategories,
  getCatalogCategoryFilterPath,
  getCatalogPopularFilterPath,
} from "@/data/catalog-filters";
import { catalogCategories } from "@/data/catalog-products";
import {
  compressionStockingBrands,
  getCompressionBrandPath,
} from "@/data/compression-stockings";
import { WHATSAPP_URL } from "@/lib/whatsapp";

interface Props {
  whatsappUrl?: string;
  whatsappLabel?: string;
}

const {
  whatsappUrl = WHATSAPP_URL,
  whatsappLabel = "Fale conosco",
} = Astro.props;

const productGroups = catalogCategories.map((category) => ({
  id: category.id,
  label: category.shortName,
  href: getCatalogCategoryFilterPath(category.id),
  items: catalogSubcategories
    .filter((subcategory) => subcategory.categoryId === category.id)
    .map((subcategory) => ({
      id: subcategory.id,
      label: subcategory.label,
      description: subcategory.description,
      href: getCatalogPopularFilterPath(subcategory.id),
    })),
}));

const compressionItems = compressionStockingBrands.map((brand) => {
  const lineCount = new Set(brand.lines.map((line) => line.line)).size;

  return {
    id: brand.id,
    label: brand.name,
    description: `${lineCount} ${lineCount === 1 ? "linha disponível" : "linhas disponíveis"}`,
    href: getCompressionBrandPath(brand.id),
  };
});
---

<div class="border-b border-primary-foreground/15 bg-primary text-primary-foreground">
  <div class="mx-auto flex min-h-9 w-full max-w-7xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-2 text-xs sm:px-6 sm:text-sm">
    <a
      href="https://www.google.com/maps/search/?api=1&query=Av.%20Afonso%20Pena%2C%20981%2C%20Belo%20Horizonte"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 hover:underline"
    >
      <MapPin className="size-3.5" />
      <span class="hidden sm:inline">Av. Afonso Pena, 981 · Centro · Belo Horizonte</span>
      <span class="sm:hidden">Loja no Centro de BH</span>
    </a>
    <div class="flex shrink-0 items-center gap-x-4">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-medium hover:underline"
      >
        <img src="/icons/whatsapp.svg" alt="" class="size-3.5" />
        (31) 3224-4407
      </a>
      <span class="-ml-3 text-[10px] leading-tight text-primary-foreground/75 sm:text-xs">
        (não aceita ligações)
      </span>
      <a href="tel:+553132244446" class="inline-flex items-center gap-1.5 font-medium hover:underline">
        <Phone className="size-3.5" />
        (31) 3224-4446
      </a>
    </div>
  </div>
</div>

<SiteHeaderClient
  client:idle
  productGroups={productGroups}
  compressionItems={compressionItems}
  whatsappUrl={whatsappUrl}
  whatsappLabel={whatsappLabel}
/>
