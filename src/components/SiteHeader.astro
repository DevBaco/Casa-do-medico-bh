---
import { MessageCircle, Phone } from "lucide-react";
import SiteHeaderClient from "@/components/SiteHeaderClient";
import { getCatalogCategoryFilterPath } from "@/data/catalog-filters";
import { catalogCategories } from "@/data/catalog-products";
import {
  compressionStockingBrands,
  getCompressionBrandPath,
} from "@/data/compression-stockings";
import { WHATSAPP_URL } from "@/lib/whatsapp";

interface Props {
  whatsappUrl?: string;
  whatsappLabel?: string;
}

const {
  whatsappUrl = WHATSAPP_URL,
  whatsappLabel = "Fale conosco",
} = Astro.props;

const productItems = catalogCategories.map((category) => ({
  id: category.id,
  label: category.shortName,
  description: category.description,
  href: getCatalogCategoryFilterPath(category.id),
}));

const compressionItems = compressionStockingBrands.map((brand) => {
  const lineCount = new Set(brand.lines.map((line) => line.line)).size;

  return {
    id: brand.id,
    label: brand.name,
    description: `${lineCount} ${lineCount === 1 ? "linha disponível" : "linhas disponíveis"}`,
    href: getCompressionBrandPath(brand.id),
  };
});
---

<div class="w-full bg-primary text-primary-foreground">
  <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-center gap-x-5 gap-y-1 px-5 py-1.5 text-xs sm:justify-end sm:px-6">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 hover:underline"
    >
      <MessageCircle className="size-3.5" aria-hidden="true" />
      (31) 3224-4407
    </a>
    <a href="tel:+553132244446" class="flex items-center gap-1.5 hover:underline">
      <Phone className="size-3.5" aria-hidden="true" />
      (31) 3224-4446
    </a>
  </div>
</div>

<SiteHeaderClient
  client:idle
  productItems={productItems}
  compressionItems={compressionItems}
  whatsappUrl={whatsappUrl}
  whatsappLabel={whatsappLabel}
/>
