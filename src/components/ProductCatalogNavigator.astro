---
import { ChevronLeft, ChevronRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { catalogProducts } from "@/data/catalog-products";
import { cn } from "@/lib/utils";

interface Props {
  basePath?: string;
}

const { basePath = "" } = Astro.props;
---

<Card className="gap-0 overflow-hidden py-0 shadow-sm" data-product-navigator>
  <CardContent className="p-0">
    <div class="flex items-center justify-between gap-4 border-b px-4 py-3.5 sm:px-5">
      <div>
        <h2 class="font-semibold">Encontre por produto</h2>
        <p class="mt-0.5 text-xs text-muted-foreground">
          Selecione uma miniatura para ir direto ao item e aos produtos semelhantes.
        </p>
      </div>

      <div class="flex shrink-0 gap-2">
        <button
          type="button"
          class={cn(buttonVariants({ variant: "outline", size: "icon-sm" }), "rounded-full")}
          data-product-scroll="previous"
          aria-label="Ver produtos anteriores"
          aria-controls="product-shortcuts"
        >
          <ChevronLeft className="size-4" />
        </button>
        <button
          type="button"
          class={cn(buttonVariants({ variant: "outline", size: "icon-sm" }), "rounded-full")}
          data-product-scroll="next"
          aria-label="Ver próximos produtos"
          aria-controls="product-shortcuts"
        >
          <ChevronRight className="size-4" />
        </button>
      </div>
    </div>

    <div
      id="product-shortcuts"
      class="flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 py-5 [scrollbar-width:none] sm:gap-5 sm:px-5 [&::-webkit-scrollbar]:hidden"
      data-product-shortcuts
    >
      {catalogProducts.map((product) => (
        <a
          href={`${basePath}#${product.id}`}
          class="group flex w-24 shrink-0 snap-start flex-col items-center gap-2.5 text-center sm:w-28"
          data-product-shortcut
          aria-label={`Ir para ${product.name}`}
        >
          <span class="grid size-20 place-items-center overflow-hidden rounded-full bg-white shadow-sm ring-4 ring-accent/20 transition-[transform,box-shadow,--tw-ring-color] group-hover:-translate-y-0.5 group-hover:shadow-md group-hover:ring-primary/20 sm:size-24">
            <img
              src={product.images[0].src}
              alt=""
              loading="lazy"
              class:list={[
                "h-full w-full object-contain object-center",
                product.imageInset === "large"
                  ? "p-4 sm:p-5"
                  : product.imageInset === "medium"
                    ? "p-3.5 sm:p-4"
                    : "p-2 sm:p-2.5",
              ]}
            />
          </span>
          <span class="line-clamp-3 text-xs font-medium leading-tight text-foreground transition-colors group-hover:text-primary sm:text-sm">
            {product.name}
          </span>
        </a>
      ))}
    </div>
  </CardContent>
</Card>

<script>
  document.querySelectorAll<HTMLElement>("[data-product-navigator]").forEach((navigator) => {
    const shortcuts = navigator.querySelector<HTMLElement>("[data-product-shortcuts]");

    navigator.querySelectorAll<HTMLButtonElement>("[data-product-scroll]").forEach((button) => {
      button.addEventListener("click", () => {
        const direction = button.dataset.productScroll === "previous" ? -1 : 1;
        shortcuts?.scrollBy({
          left: direction * Math.max(shortcuts.clientWidth * 0.75, 320),
          behavior: "smooth",
        });
      });
    });
  });
</script>
