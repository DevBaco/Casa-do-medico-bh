---
import { ArrowRight, ArrowUpRight } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  getCompressionStockingPath,
  type StockingLine,
} from "@/data/compression-stockings";
import { cn } from "@/lib/utils";

interface Props {
  line: StockingLine;
}

const { line } = Astro.props;
const href = getCompressionStockingPath(line);
---

<Card
  id={line.id}
  data-product-card
  className="h-full scroll-mt-24 gap-0 overflow-hidden rounded-lg p-0 transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg"
>
  <a
    href={href}
    class="group relative flex aspect-[5/4] w-full snap-x snap-mandatory overflow-x-auto bg-white [scrollbar-width:none] md:grid md:place-items-center md:overflow-hidden [&::-webkit-scrollbar]:hidden"
    aria-label={`Ver ${line.displayName}`}
  >
    <img
      src={line.genericImage}
      alt={line.displayName}
      loading="lazy"
      data-role="generic-image"
      class="h-full w-full shrink-0 snap-center object-contain object-center transition-opacity duration-200 md:absolute md:inset-0 md:group-hover:opacity-0"
    />
    <img
      src={line.boxImage}
      alt={`Embalagem ${line.displayName}`}
      loading="lazy"
      class="h-full w-full shrink-0 snap-center object-contain object-center p-4 transition-opacity duration-200 md:absolute md:inset-0 md:p-5 md:opacity-0 md:group-hover:opacity-100"
    />
    <span class="pointer-events-none absolute right-3 bottom-3 hidden rounded-md border bg-background/95 px-2.5 py-1 text-xs font-semibold text-primary shadow-sm md:block">
      Ver produto
    </span>
    <span class="pointer-events-none absolute right-3 bottom-3 flex gap-1.5 md:hidden" aria-hidden="true">
      <span class="size-1.5 rounded-full bg-primary"></span>
      <span class="size-1.5 rounded-full bg-border"></span>
    </span>
  </a>

  <CardContent className="flex min-h-[270px] flex-1 flex-col gap-3 border-t p-4">
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Cores disponíveis">
      {line.colors.map((color) => (
        <button
          type="button"
          class="color-swatch size-4.5 shrink-0 rounded-full border border-black/10 shadow-sm transition-transform hover:scale-125 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          style={`background-color:${color.swatch}`}
          data-image={color.image}
          aria-label={color.name}
        />
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <Badge>{line.brandName}</Badge>
      {line.badges.slice(0, 2).map((badge) => <Badge variant="secondary">{badge}</Badge>)}
    </div>

    <div>
      <a href={href} class="group/title inline-flex items-start gap-2">
        <h3 class="text-lg font-semibold leading-snug">{line.displayName}</h3>
        <ArrowUpRight className="mt-1 size-4 shrink-0 text-muted-foreground transition-colors group-hover/title:text-primary" />
      </a>
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
        {line.summary}
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {line.compression.slice(0, 2).map((compression) => (
        <Badge variant="secondary">{compression}</Badge>
      ))}
    </div>

    <div class="mt-auto pt-1">
      <a href={href} class={cn(buttonVariants({ size: "lg" }), "w-full")}>
        Ver detalhes do produto
        <ArrowRight className="size-4" />
      </a>
    </div>
  </CardContent>
</Card>

<script>
  document.addEventListener("click", (event) => {
    const swatch = (event.target as HTMLElement).closest<HTMLButtonElement>(".color-swatch");
    if (!swatch) return;

    const card = swatch.closest<HTMLElement>("[data-product-card]");
    const image = card?.querySelector<HTMLImageElement>('[data-role="generic-image"]');
    if (image && swatch.dataset.image) {
      image.src = swatch.dataset.image;
    }
  });
</script>
